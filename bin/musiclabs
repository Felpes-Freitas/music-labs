#!/usr/bin/env bash
# Abre o Music Labs: sobe o servidor (se preciso) e abre a interface como app.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PORT="${BATUQUE_PORT:-7717}"
URL="http://127.0.0.1:$PORT"
NODE="$(command -v node)"
# Node 22+ (nvm)
for n in "$HOME"/.nvm/versions/node/v2[2-9]*/bin/node; do [ -x "$n" ] && NODE="$n"; done
if ! curl -fs "$URL/api/status" >/dev/null 2>&1; then
  mkdir -p "$HOME/.local/state"
  nohup "$NODE" "$DIR/build/server.mjs" >"$HOME/.local/state/batuque.log" 2>&1 &
  for _ in $(seq 1 50); do curl -fs "$URL/api/status" >/dev/null 2>&1 && break; sleep 0.1; done
fi
[ "${1:-}" = "--server-only" ] && exit 0
for b in google-chrome chromium brave-browser; do
  if command -v "$b" >/dev/null; then exec "$b" --app="$URL" --class=MusicLabs --user-data-dir="$HOME/.local/share/batuque/chrome" --no-first-run --autoplay-policy=no-user-gesture-required >/dev/null 2>&1; fi
done
xdg-open "$URL"
