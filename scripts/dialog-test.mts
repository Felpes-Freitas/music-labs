import { chromium } from 'playwright-core';
const B = process.argv[2] ?? 'http://127.0.0.1:7799';
const browser = await chromium.launch({ executablePath: '/usr/bin/google-chrome', headless: true, args: ['--autoplay-policy=no-user-gesture-required'] });
const page = await browser.newPage({ viewport: { width: 1400, height: 860 }, deviceScaleFactor: 1 });
let native = 0;
page.on('dialog', async (d) => { native++; await d.dismiss(); });
await page.goto(B);
await page.waitForSelector('.loading', { state: 'detached', timeout: 30000 });
const bpm = async () => (await (await fetch(B + '/api/project')).json()).project.bpm;
await page.dblclick('.bpmval');
await page.waitForSelector('.dlg');
await page.keyboard.press('Control+a');
await page.keyboard.type('93');
await page.screenshot({ path: '/tmp/dlg-text.png' });
await page.keyboard.press('Enter');
await page.waitForTimeout(200);
console.log('BPM pelo diálogo:', await bpm(), '| diálogo fechou:', (await page.$('.dlg')) === null);
await page.dblclick('.bpmval');
await page.keyboard.type('999');
await page.keyboard.press('Enter');
console.log('valor inválido mantém o diálogo aberto:', (await page.$('.dlg')) !== null);
await page.keyboard.press('Escape');
await page.waitForTimeout(100);
console.log('Esc cancela:', (await page.$('.dlg')) === null, '| BPM continua', await bpm());
await page.click('.menu-btn:has-text("Arquivo")');
await page.click('.menu-item:has-text("Novo (com bateria)")');
await page.waitForSelector('.dlg.danger');
await page.screenshot({ path: '/tmp/dlg-confirm.png' });
await page.click('.dlg button:has-text("Cancelar")');
console.log('confirmação cancelada; diálogos nativos do navegador:', native);
await browser.close();
